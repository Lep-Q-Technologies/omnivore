# Google OAuth Configuration
VITE_GAUTH_CLIENT_ID=your-google-oauth-client-id-here

# API Configuration
VITE_API_URL=http://localhost:4001/api/v2
VITE_SERVER_BASE_URL=http://localhost:4001

# Optional: For development/demo purposes only
# The Settings page uses this to display a demo API key in the UI
# This is NOT a real key and is never sent to any server
VITE_DEMO_API_KEY=demo_key_for_ui_display_only
