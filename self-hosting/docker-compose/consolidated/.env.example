# Omnivore Consolidated Deployment Configuration
# Copy this file to .env and customize the values for your deployment

# =============================================================================
# DEPLOYMENT PROFILE
# =============================================================================
# Choose your deployment profile: minimal, standard, enterprise
DEPLOYMENT_PROFILE=standard

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=omnivore
POSTGRES_USER=omnivore
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_PORT=5432

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# =============================================================================
# APPLICATION URLS
# =============================================================================
# Update these URLs to match your deployment domain
BASE_URL=http://localhost:3000
SERVER_BASE_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000
HIGHLIGHTS_BASE_URL=http://localhost:3000

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Generate strong random secrets for production
JWT_SECRET=your-jwt-secret-here-change-in-production
SSO_JWT_SECRET=your-sso-jwt-secret-here-change-in-production
IMAGE_PROXY_SECRET=your-image-proxy-secret-here-change-in-production

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
# Storage type: local, s3, gcs
STORAGE_TYPE=local
# For local storage, files will be stored in Docker volumes
# For S3/GCS, configure the bucket and region below
GCS_UPLOAD_BUCKET=omnivore-local
AWS_REGION=us-east-1
AWS_S3_BUCKET=omnivore-storage

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features based on your needs and resources

# Core content processing (recommended: true)
ENABLE_CONTENT_PROCESSING=true

# PDF document processing (requires more memory)
ENABLE_PDF_PROCESSING=true

# Thumbnail generation (requires more CPU)
ENABLE_THUMBNAIL_GENERATION=true

# Email ingestion via IMAP (requires email configuration)
ENABLE_EMAIL_INGESTION=false

# AI-powered features (requires AI service configuration)
ENABLE_AI_FEATURES=false

# Text-to-speech functionality
ENABLE_TEXT_TO_SPEECH=false

# RSS feed handling
ENABLE_RSS_HANDLING=true

# Third-party integrations (Notion, etc.)
ENABLE_INTEGRATIONS=true

# Advanced search with Elasticsearch (not implemented in consolidated version)
ENABLE_ELASTICSEARCH=false

# =============================================================================
# RESOURCE LIMITS
# =============================================================================
# Adjust based on your server capacity

# Main service workers
MAX_WORKERS=4
MAX_CONCURRENT_JOBS=10

# Worker service (if using separate worker profile)
WORKER_MAX_WORKERS=8
WORKER_MAX_CONCURRENT_JOBS=20

# =============================================================================
# EMAIL CONFIGURATION (if ENABLE_EMAIL_INGESTION=true)
# =============================================================================
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=your-email@gmail.com
# IMAP_PASSWORD=your-app-password
# IMAP_USE_TLS=true

# =============================================================================
# AI CONFIGURATION (if ENABLE_AI_FEATURES=true)
# =============================================================================
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# =============================================================================
# THIRD-PARTY INTEGRATIONS (if ENABLE_INTEGRATIONS=true)
# =============================================================================
# NOTION_CLIENT_ID=your-notion-client-id
# NOTION_CLIENT_SECRET=your-notion-client-secret

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# LOG_LEVEL=info
# SENTRY_DSN=your-sentry-dsn-for-error-tracking

# =============================================================================
# DEVELOPMENT OPTIONS
# =============================================================================
# Set to true for development/debugging
# DEBUG=false
# NODE_ENV=production