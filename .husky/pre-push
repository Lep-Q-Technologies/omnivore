echo "🧪 Running unit tests for api-nest and web-vite..."
# Run tests serially to avoid parallel resource contention with external HTTP requests
# Note: omnivore-polish tests not yet configured - will add when E2E tests implemented
yarn workspace @omnivore/api-nest test --runInBand && yarn workspace web-vite test

if [ $? -ne 0 ]; then
  echo "❌ Unit tests failed. Push aborted."
  echo "Fix the failing tests or use --no-verify to skip this hook."
  exit 1
fi

echo "✅ Unit tests passed."
echo ""
echo "🧪 Running E2E tests for api-nest..."
yarn workspace @omnivore/api-nest test:e2e

if [ $? -ne 0 ]; then
  echo "❌ E2E tests failed. Push aborted."
  echo "Fix the failing tests or use --no-verify to skip this hook."
  exit 1
fi

echo "✅ All tests passed (unit + E2E). Proceeding with push."
